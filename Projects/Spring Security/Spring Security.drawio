l; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;div style=&quot;background-color:#1e1f22;color:#bcbec4&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9.8pt;&quot;&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;@RestController&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;@RequestMapping&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;/api&quot;&lt;/span&gt;)&lt;br&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;public class &lt;/span&gt;HelloController {&lt;br&gt;    &lt;span style=&quot;color:#b3ae60;&quot;&gt;@GetMapping&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;/spring&quot;&lt;/span&gt;)&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;public &lt;/span&gt;String  &lt;span style=&quot;color:#56a8f5;&quot;&gt;SpringSecurity&lt;/span&gt;(HttpServletRequest request) {&lt;br&gt;        &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return &lt;/span&gt;&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;Welcome to Spring Security But Without using Security . Only web spring , Spring web tool&quot; &lt;/span&gt;+&lt;br&gt;                &lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;json web token id is:-  &quot;&lt;/span&gt;+request.getSession().getId();&lt;br&gt;    }&lt;br&gt;}&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2;