        <mxCell id="J3uz-5T8VQfXddI1SDsT-2" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Spring Security With Spring Boot &amp;amp; JWT (JSON WEB TOKEN)&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;OWASP ( OPEN WEB APLLICATION SECURITY PROJECT)[CHANGE AFTER 4 YEARS SPRING SECURITY]&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;Create new project And Dependency&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;Spring Boot&amp;nbsp; create project&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;&lt;b&gt;Add Dependency&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;1)Spring web&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;2)Spring Boot Dev Tools&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;GIT HUB LINK HERE&amp;nbsp; &lt;/span&gt;Without Using Security&lt;/p&gt;&lt;div style=&quot;box-sizing: border-box; display: flex; min-width: 0px; font-size: 14px; -webkit-box-align: center; align-items: center; width: max-content; gap: 8px; -webkit-box-flex: 1; flex-grow: 1; color: rgb(31, 35, 40); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Noto Sans&amp;quot;, Helvetica,